# These defaults are for trying it out locally at http://localhost:8090.
# Before deploying for real, see the "Deploying it for real" section in
# README.md and change: APP_ENV=production, SESSION_SECURE_COOKIE=true,
# APP_URL/APP_DOMAIN to your real domain, and APP_PORT=80 (if nothing else
# on the host needs that port).
APP_NAME=Soundboard
APP_ENV=local
APP_KEY=
APP_DEBUG=false

# Host port nginx is published on (docker-compose.yml's ${APP_PORT:-8090}).
APP_PORT=8090

# The domain (or IP) this is reachable at. Nginx here only serves plain
# HTTP — if you want a real HTTPS domain, put a reverse proxy/tunnel you
# already run in front of this stack and point it at nginx:80 (or the
# published port). See README.md.
APP_DOMAIN=localhost:${APP_PORT}
APP_URL=http://${APP_DOMAIN}

# Set this to the proxy's IP/CIDR (or `*` to trust any) if APP_URL is https
# but nginx itself only speaks HTTP — otherwise Laravel won't know the
# original request was secure and will generate http:// URLs / reject
# secure cookies. Leave blank if nothing sits in front of nginx.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=soundboard
DB_USERNAME=soundboard
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database

# IMPORTANT: the "log" mailer does NOT send real emails — registration/email
# verification and password-reset links will only appear in the container's
# log files. Before letting real people sign up (or use "forgot password"),
# switch this to a real transactional email provider. Brevo (SMTP relay)
# example — swap MAIL_MAILER to smtp, and fill in MAIL_USERNAME (your Brevo
# account login email) / MAIL_PASSWORD (an SMTP key from Brevo's
# Senders & IP > SMTP & API page, not your account password) /
# MAIL_FROM_ADDRESS (a sender verified in Brevo):
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
